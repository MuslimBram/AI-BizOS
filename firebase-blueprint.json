{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document containing RBAC details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "user"] },
        "avatar": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "email", "name", "role", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with role details."
    }
  }
}

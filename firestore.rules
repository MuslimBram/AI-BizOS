rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User Profiles
    match /users/{userId} {
      // Users can read their own profile, or any authenticated user can read if they have admin role (basic pattern)
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin']);
      
      // Allow create only if it matches their own ID and strict schema - we're using hasAll to guarantee at least these keys but extra ones are okay
      allow create: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasAll(['id', 'email', 'name'])
                   && request.resource.data.id == request.auth.uid;
                   
      allow update: if request.auth != null && request.auth.uid == userId;
    }
  }
}
